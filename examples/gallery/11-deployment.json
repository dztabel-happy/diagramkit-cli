    }
  ],
  "messages": [
    {
      "id": "m1",
      "from": "dev",
      "to": "git",
      "kind": "call",
      "label": "git push origin feature/payment-retries"
    },
    {
      "id": "m2",
      "from": "git",
      "to": "ci",
      "kind": "async",
      "label": "webhook: push event"
    },
    {
      "id": "m3",
      "from": "ci",
      "to": "build",
      "kind": "call",
      "label": "spawn ephemeral build agent"
    },
    {
      "id": "m4",
      "from": "build",
      "to": "build",
      "kind": "call",
      "label": "compile and run unit tests"
    },
    {
      "id": "m5",
      "from": "build",
      "to": "reg",
      "kind": "call",
      "label": "upload image"
    },
    {
      "id": "m6",
      "from": "ci",
      "to": "scan",
      "kind": "call",
      "label": "scan dependencies"
    },
    {
      "id": "m7",
      "from": "scan",
      "to": "ci",
      "kind": "return",
      "label": "no critical CVEs"
    },
    {
      "id": "m8",
      "from": "ci",
      "to": "k8s",
      "kind": "call",
      "label": "notify deployment window"
    },
    {
      "id": "m9",
      "from": "ci",
      "to": "k8s",
      "kind": "call",
      "label": "rolling update, 25% surge"
    },
    {
      "id": "m10",
      "from": "k8s",
      "to": "k8s",
      "kind": "call",
      "label": "health probe"
    },
    {
      "id": "m11",
      "from": "k8s",
      "to": "ci",
      "kind": "return",
      "label": "rollout complete"
    },
    {
      "id": "m12",
      "from": "ci",
      "to": "build",
      "kind": "call",
      "label": "tear down agent"
    },
    {
      "id": "m13",
      "from": "ci",
      "to": "dev",
      "kind": "return",
      "label": "deployment succeeded in 4m12s"
    }
  ],
  "fragments": [
    {
      "id": "p",
      "kind": "par",
      "label": "build",
      "start": "m3",
      "end": "m8",
      "branches": [
        {
          "label": "build",
          "start": "m3",
          "end": "m5"
        },
        {
          "label": "security scan",
