      "symbol": "database"
    },
    {
      "id": "k8s",
      "label": "Kubernetes Cluster",
      "role": "service"
    }
  ],
  "participantGroups": [
    {
      "id": "g",
      "label": "Build farm",
      "participants": [
        "build",
        "scan"
      ],
