          "end": "m7"
        },
        {
          "label": "announce",
          "start": "m8",
          "end": "m8"
        }
      ]
    },
    {
      "id": "l",
      "kind": "loop",
      "label": "for each of 3 availability zones",
      "start": "m9",
      "end": "m11"
    },
    {
      "id": "o",
      "kind": "opt",
      "label": "readiness probe fails",
      "start": "m10",
      "end": "m10",
      "parent": "l"
