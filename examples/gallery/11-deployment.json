  "mirrorParticipants": true,
  "participants": [
    {
      "id": "dev",
      "label": "Developer",
      "role": "actor",
      "symbol": "actor"
    },
    {
      "id": "git",
      "label": "Git Server",
      "role": "service"
    },
    {
      "id": "ci",
      "label": "CI Orchestrator",
      "role": "service"
    },
    {
      "id": "build",
      "label": "Build Agent",
      "role": "service"
    },
    {
      "id": "scan",
      "label": "Security Scanner",
      "role": "service"
    },
    {
      "id": "reg",
      "label": "Artifact Registry",
