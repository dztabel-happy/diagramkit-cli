      "to": "complete",
      "kind": "main"
    },
    {
      "id": "e3",
      "from": "complete",
      "to": "supplement",
      "kind": "branch",
      "label": "否"
    },
    {
      "id": "e4",
      "from": "supplement",
      "to": "submit",
      "kind": "return",
      "label": "重新提交"
    },
    {
      "id": "e5",
      "from": "complete",
      "to": "amount",
      "kind": "branch",
      "label": "是"
    },
    {
      "id": "e6",
      "from": "amount",
      "to": "manager",
      "kind": "branch",
      "label": "否"
    },
    {
      "id": "e7",
      "from": "amount",
      "to": "director",
      "kind": "branch",
      "label": "是"
    },
    {
      "id": "e8",
      "from": "manager",
      "to": "approved",
      "kind": "main"
    },
    {
      "id": "e9",
      "from": "director",
      "to": "approved",
      "kind": "main"
    },
    {
      "id": "e10",
      "from": "approved",
      "to": "reject",
      "kind": "branch",
      "label": "否"
    },
    {
      "id": "e11",
