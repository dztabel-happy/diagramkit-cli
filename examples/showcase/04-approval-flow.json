      "shape": "diamond",
      "tone": "yellow"
    },
    {
      "id": "supplement",
      "label": "退回补充材料",
      "role": "abnormal",
      "shape": "rectangle",
      "tone": "red"
    },
    {
      "id": "amount",
      "label": "金额是否超过 5000 元?",
      "role": "decision",
      "shape": "diamond",
      "tone": "yellow"
    },
    {
      "id": "manager",
      "label": "部门经理审批",
      "role": "step",
      "shape": "rectangle",
      "tone": "blue"
    },
    {
      "id": "director",
      "label": "财务总监审批",
      "role": "step",
      "shape": "rectangle",
      "tone": "blue"
    },
    {
